@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="home-stack">
    <partial name="_SearchBar" model="Model.Filter" />

    <partial name="_CategoryStrip" model="Model.CategoryStrip" />

    <div class="property-grid">
        @foreach (var property in Model.Properties)
        {
            <partial name="_PropertyCard" model="property" />
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/search-bar/search-bar.js" type="module" asp-append-version="true"></script>
}