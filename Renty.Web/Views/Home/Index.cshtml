@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="home-stack">
    <div class="home-stack__search-row">
        <div class="home-stack__search-bar-wrap">
            <partial name="_SearchBar" model="Model.Filter" />
        </div>
        <button type="button" class="btn-primary home-stack__map-button">
            <span>Показати мапу</span>
            <icon name="map" />
        </button>
    </div>

    <partial name="_CategoryStrip" model="Model.CategoryStrip" />
    

    <div class="property-grid">
        @foreach (var property in Model.Properties)
        {
            <partial name="_PropertyCard" model="property" />
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/search-bar/search-bar.js" type="module" asp-append-version="true"></script>
}
