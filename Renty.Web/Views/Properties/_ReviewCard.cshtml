@model ReviewViewModel

<div class="review-card">
    <div class="review-card__header">
        <img src="@Model.AuthorAvatarUrl" alt="@Model.AuthorName" class="review-card__avatar" />
        <div>
            <p class="review-card__author">@Model.AuthorName</p>
            <p class="review-card__date">@Model.CreatedAt.ToString("d MMMM yyyy")</p>
        </div>
    </div>
    <p class="review-card__text">@Model.Text</p>
</div>
