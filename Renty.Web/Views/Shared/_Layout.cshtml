<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Renty.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/popovers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/guests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/counter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/option-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toggle-switch.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Renty.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="@(ViewData["StickyHeader"] as bool? == true ? "site-header--sticky" : "")">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="site-header__inner">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Renty</a>
                <div class="site-header__search">
                    @await RenderSectionAsync("HeaderSearch", required: false)
                </div>
                <div class="site-header__menu">
                    <partial name="_MainMenu" />
                </div>
            </div>
            @await RenderSectionAsync("HeaderCategories", required: false)
        </nav>
    </header>
    <div class="@(ViewData["FullWidth"] as bool? == true ? "container-fluid" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_LoginModal" model="new LoginViewModel()" />

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Renty.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/main-menu/main-menu.js" type="module" asp-append-version="true"></script>
    @if (IsSectionDefined("HeaderSearch"))
    {
        <script src="~/js/search-bar/search-bar.js" type="module" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
