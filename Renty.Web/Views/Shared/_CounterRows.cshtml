@model IEnumerable<CounterRowViewModel>

@foreach (var counter in Model)
{
    <div class="popover-row" data-counter="@counter.Key" data-counter-min="@counter.Min" data-counter-max="@counter.Max">
        <div class="popover-row__info">
            <p class="popover-row__title">@counter.Title</p>
            @if (!string.IsNullOrEmpty(counter.Subtitle))
            {
                <p class="popover-row__subtitle">@counter.Subtitle</p>
            }
        </div>
        <div class="popover-row__controls">
            <button type="button" class="popover-row__btn popover-row__btn--minus">−</button>
            <span class="popover-row__count">@counter.Min</span>
            <button type="button" class="popover-row__btn popover-row__btn--plus">+</button>
        </div>
    </div>
}
