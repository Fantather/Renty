@{
    var guestCounters = new List<CounterRowViewModel>
    {
        new() { Key = "guest", Title = "Максимальное количество гостей", Min = 1, Max = ViewData["MaxGuests"] as int? },
    };
}

<partial name="_CounterRows" model="guestCounters" />

<div class="popover-row">
    <p class="popover-row__title">Заезд с питомцами</p>
    <label class="toggle">
        <input type="checkbox" class="toggle__input" id="petsToggle" />
        <span class="toggle__track">
            <span class="toggle__knob"></span>
        </span>
    </label>
</div>
