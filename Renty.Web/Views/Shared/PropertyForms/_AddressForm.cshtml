@model Renty.Web.Models.InputModels.Properties.AddressInputModel

<form class="address-form" method="post" id="address-form">
    <div class="search-field">
        <input type="text" id="search" class="input-field__input" placeholder="Начните вводить адрес" autocomplete="off" />
        <div id="search-popover" class="popover-panel search-field__results" hidden>
            <template>
                <icon name="map-pin" />
            </template>
        </div>
    </div>

    <input type="hidden" asp-for="PlaceId" />

    <div id="address-details">
        <input-field asp-for="Address" placeholder="Улица, дом" />
        <input-field asp-for="Street" placeholder="Квартира или номер дома" />
        <input-field asp-for="District" placeholder="Район" />
        <input-field asp-for="CityName" placeholder="Город" />
        <input-field asp-for="CountryName" placeholder="Страна" />
    </div>
</form>
