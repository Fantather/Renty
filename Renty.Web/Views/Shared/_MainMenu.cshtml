@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="main-menu">
    <button type="button" class="main-menu__trigger" id="mainMenuTrigger">
        <icon name="star" class="main-menu__trigger-icon" />
    </button>

    <div class="popover-panel main-menu__popover" id="mainMenuPopover" hidden>
        <a class="main-menu__item" asp-controller="PropertyCreate" asp-action="PropertyAddress">Сдать жильё</a>
        @if (isAuthenticated)
        {
            <form method="post" asp-controller="Account" asp-action="Logout">
                <button type="submit" class="main-menu__item">Выйти</button>
            </form>
        }
        else
        {
            <button type="button" class="main-menu__item" id="loginTrigger">Войти или зарегистрироваться</button>
        }
    </div>
</div>
