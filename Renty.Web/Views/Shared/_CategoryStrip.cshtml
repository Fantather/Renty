@model CategoryStripViewModel
@{
    var baseRoute = new Dictionary<string, string>();

    if (!string.IsNullOrEmpty(Model.Filter?.Destination)) baseRoute["destination"] = Model.Filter.Destination;
    if (Model.Filter?.CheckInDate != null) baseRoute["checkInDate"] = Model.Filter.CheckInDate.Value.ToString("yyyy-MM-dd");
    if (Model.Filter?.CheckOutDate != null) baseRoute["checkOutDate"] = Model.Filter.CheckOutDate.Value.ToString("yyyy-MM-dd");
    if (Model.Filter?.GuestCount > 0) baseRoute["guestCount"] = Model.Filter.GuestCount.ToString();
    if (Model.Filter?.Pets == true) baseRoute["pets"] = "true";

    if (Model.Filter?.North != null && Model.Filter.South != null && Model.Filter.East != null && Model.Filter.West != null)
    {
        baseRoute["north"] = Model.Filter.North.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        baseRoute["south"] = Model.Filter.South.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        baseRoute["east"] = Model.Filter.East.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        baseRoute["west"] = Model.Filter.West.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
}

<div class="category-strip">
    @foreach (CategoryViewModel category in Model.Categories)
    {
        bool isActive = category.Slug == Model.SelectedSlug;
        var routeValues = new Dictionary<string, string>(baseRoute);
        if (!isActive) routeValues["categorySlug"] = category.Slug;

        <a asp-action="Index" asp-all-route-data="routeValues" class="category-strip__item @(isActive ? "is-active" : "")">
            <icon name="@category.IconName" class="category-strip__icon" />
            <span class="category-strip__label">@category.Name</span>
        </a>
    }
</div>
