@model Renty.Web.Models.PropertyFilterViewModel
@{
    var guestsTotal = (Model.AdultCount ?? 0) + (Model.ChildCount ?? 0) + (Model.InfantCount ?? 0) + (Model.PetCount ?? 0);

    var dateLabel = (Model.CheckInDate.HasValue && Model.CheckOutDate.HasValue)
        ? $"{Model.CheckInDate.Value:d MMM} – {Model.CheckOutDate.Value:d MMM}"
        : "Когда?";
}

<div class="search-bar">
    <button type="button" class="search-bar__segment">
        <span class="search-bar__label">Где</span>
        <span class="search-bar__value">@(string.IsNullOrEmpty(Model.Destination) ? "Поиск направлений" : Model.Destination)</span>
    </button>

    <span class="search-bar__divider"></span>

    <button type="button" class="search-bar__segment" id="dateSegment">
        <span class="search-bar__label">Когда</span>
        <span class="search-bar__value">@dateLabel</span>
    </button>

    <span class="search-bar__divider"></span>

    <button type="button" class="search-bar__segment">
        <span class="search-bar__label">Кто</span>
        <span class="search-bar__value">@(guestsTotal > 0 ? $"Гостей: {guestsTotal}" : "Кто едет?")</span>
    </button>

    <button type="button" class="search-bar__submit">
        <icon name="star" class="search-bar__submit-icon" />
    </button>

    <div class="date-popover" id="datePopover" hidden></div>
</div>