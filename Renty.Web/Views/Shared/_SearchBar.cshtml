@using System.Globalization
@model PropertyFilterViewModel
@{
    var hasBounds = Model.North.HasValue && Model.South.HasValue && Model.East.HasValue && Model.West.HasValue;
    var defaultPlaceholder = "Поиск направлений";
    var areaPlaceholder = "Жильё в этой части карты";

    var guestsTotal = Model.GuestCount;

    var dateLabel = (Model.CheckInDate.HasValue && Model.CheckOutDate.HasValue)
        ? $"{Model.CheckInDate.Value:d MMM} – {Model.CheckOutDate.Value:d MMM}"
        : "Когда?";
}

<form method="get" asp-controller="Search" asp-action="Index">
<div class="search-bar">
    <div class="search-bar__segment" id="destinationSegment">
        <label class="search-bar__label" for="destinationInput">Где</label>
        <input type="text" class="search-bar__value search-bar__input" id="destinationInput" name="Destination"
               placeholder="@(hasBounds ? areaPlaceholder : defaultPlaceholder)"
               data-default-placeholder="@defaultPlaceholder" data-area-placeholder="@areaPlaceholder"
               value="@(hasBounds ? "" : Model.Destination)" autocomplete="off" />
    </div>

    <span class="search-bar__divider"></span>

    <button type="button" class="search-bar__segment" id="dateSegment">
        <span class="search-bar__label">Когда</span>
        <span class="search-bar__value" id="dateSegmentValue">@dateLabel</span>
    </button>

    <span class="search-bar__divider"></span>

    <button type="button" class="search-bar__segment" id="guestsSegment">
        <span class="search-bar__label">Кто</span>
        <span class="search-bar__value" id="guestsSegmentValue">@(guestsTotal > 0 ? $"Гостей: {guestsTotal}" : "Кто едет?")</span>
    </button>

    <button type="submit" class="search-bar__submit">
        <icon name="magnifier" class="search-bar__submit-icon" />
    </button>



    <div class="popover-panel destination-popover" id="destinationPopover" hidden>
        <template>
            <icon name="map-pin" />
        </template>
    </div>

    <div class="popover-panel date-popover" id="datePopover" hidden>
        <button type="button" class="date-popover__nav date-popover__nav--prev" id="prevMonthBtn">
            <icon name="chevron-right" class="date-popover__nav-icon" />
        </button>
        <div class="date-popover__calendar" data-month-slot="0"></div>
        <div class="date-popover__calendar" data-month-slot="1"></div>
        <button type="button" class="date-popover__nav date-popover__nav--next" id="nextMonthBtn">
            <icon name="chevron-right" class="date-popover__nav-icon" />
        </button>
    </div>
    
    <div class="popover-panel guests-popover" id="guestsPopover" hidden>
        <partial name="_GuestsPopoverRows" />
    </div>



    <input type="hidden" name="CategorySlug" value="@Model.CategorySlug" />

    <input type="hidden" id="checkInInput" name="CheckInDate" value="@(Model.CheckInDate?.ToString("yyyy-MM-dd"))" />
    <input type="hidden" id="checkOutInput" name="CheckOutDate" value="@(Model.CheckOutDate?.ToString("yyyy-MM-dd"))" />

    <input type="hidden" id="guestCountInput" name="GuestCount" value="@Model.GuestCount" />
    <input type="hidden" id="petsInput" name="Pets" value="@(Model.Pets ? "true" : "false")" />

    <input type="hidden" id="northInput" name="North" value="@(Model.North?.ToString(CultureInfo.InvariantCulture))" />
    <input type="hidden" id="southInput" name="South" value="@(Model.South?.ToString(CultureInfo.InvariantCulture))" />
    <input type="hidden" id="eastInput" name="East" value="@(Model.East?.ToString(CultureInfo.InvariantCulture))" />
    <input type="hidden" id="westInput" name="West" value="@(Model.West?.ToString(CultureInfo.InvariantCulture))" />
</div>
</form>
