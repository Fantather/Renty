@model Renty.Web.Models.PropertyEdit.EditorMenuViewModel

<div class="editor-menu">
    @foreach (var item in Model.Items)
    {
        <a class="editor-menu__item @(item.IsActive ? "editor-menu__item--active" : "")" href="@Url.Action(item.Action, "PropertyEdit", new { id = Model.PropertyId })">
            <span class="editor-menu__title">@item.Name</span>
        </a>
    }
</div>
