@using System.Text.Json
@model SearchIndexViewModel
@section HeaderSearch {
    <partial name="_SearchBar" model="Model.Filter" />
}
@section HeaderCategories {
    <div class="site-header__categories">
        <partial name="_CategoryStrip" model="Model.CategoryStrip" />
    </div>
}
@{
    ViewData["FullWidth"] = true;
    ViewData["StickyHeader"] = true;
    var mapJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<div class="search-page">
    <div class="search-page__list">
        <h1 class="search-page__total">@Model.TotalCount вариантов жилья</h1>
        <div class="search-inner">
            @foreach (var property in Model.Properties)
            {
                <partial name="_PropertyCard" model="property" />
            }
        </div>
    </div>

    <div id="searchMap" class="search-page__search-map" data-api-key="@Model.GoogleMapsApiKey">
        <div id="searchMapCanvas" class="search-page__search-map-canvas"></div>
    </div>
</div>

<script type="application/json" id="searchMapData">@Html.Raw(JsonSerializer.Serialize(Model.Properties, mapJsonOptions))</script>

@section Scripts {
    <script src="~/js/search-page/search-map.js" type="module" asp-append-version="true"></script>
}
