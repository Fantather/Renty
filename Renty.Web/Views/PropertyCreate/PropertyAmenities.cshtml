@model Renty.Web.Models.PropertyCreate.AmenitiesPageViewModel
@{
    ViewData["Title"] = "Удобства";
}

<div class="property-amenities-page">
    <h1 class="property-amenities-page__title">Расскажите гостям, какие удобства есть в вашем жилье</h1>

    <form method="post" asp-action="SavePropertyAmenities" asp-route-id="@ViewData["PropertyId"]">
        <div class="option-card-grid">
            @foreach (var amenity in Model.Amenities)
            {
                <label class="option-card">
                    <input type="checkbox" class="option-card__input" name="AmenityIds" value="@amenity.Id" />
                    <icon name="@amenity.IconName" class="option-card__icon" />
                    <span class="option-card__label">@amenity.Name</span>
                    @if (!string.IsNullOrEmpty(amenity.Description))
                    {
                        <span class="option-card__description">@amenity.Description</span>
                    }
                </label>
            }
        </div>

        <button type="submit" class="property-amenities-next">Далее</button>
    </form>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/amenities.js" asp-append-version="true"></script>
}
