@model Renty.Web.Models.PropertyCreate.CategoryPageViewModel
@{
    ViewData["Title"] = "Тип жилья";
}

<div class="property-category-page">
    <h1 class="property-category-page__title">Что из перечисленного точнее описывает ваше жильё?</h1>

    <partial name="_CategoryForm" model="Model" />

    <button type="submit" form="property-form" class="property-category-next" disabled>Далее</button>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/category.js" asp-append-version="true"></script>
}
