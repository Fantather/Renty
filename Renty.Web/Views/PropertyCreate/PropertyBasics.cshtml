@model Renty.Web.Models.InputModels.Properties.BasicsInputModel
@{
    ViewData["Title"] = "Основная информация";
}

<div class="property-basics-page">
    <h1 class="property-basics-page__title">Поделитесь основной информацией о жилье</h1>
    <p class="property-basics-page__subtitle">Детали (например, типы кроватей) вы добавите позже.</p>

    <partial name="_BasicsForm" model="Model" />

    <button type="submit" form="property-form" class="property-basics-next">Далее</button>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/basics.js" asp-append-version="true"></script>
}
