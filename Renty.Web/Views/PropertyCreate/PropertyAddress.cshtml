@model Renty.Web.Models.InputModels.Properties.AddressInputModel
@{
    ViewData["Title"] = "Адрес объявления";
    ViewData["FormId"] = "address-form";
}

<div class="property-create-page">
    <div class="property-create-card">
        <h1 class="property-create-card__title">Подтвердите адрес</h1>
        <div asp-validation-summary="All"></div>

        <partial name="_AddressForm" model="Model" />

        <partial name="_StepFooter" />
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/address.js" asp-append-version="true"></script>
}
