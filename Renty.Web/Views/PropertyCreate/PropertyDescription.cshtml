@model Renty.Web.Models.InputModels.Properties.PropertyInputModel
@{
    ViewData["Title"] = "Описание";
}

<div class="property-description-page">
    <h1 class="property-description-page__title">Составьте описание</h1>
    <p class="property-description-page__subtitle">Расскажите, что делает ваше жильё особенным.</p>

    <form method="post" asp-action="SavePropertyDescription" asp-route-id="@ViewData["PropertyId"]">
        <input-field asp-for="Description" max-length="2000" multiline="true" />

        <button type="submit" class="property-description-next">Далее</button>
    </form>
</div>
