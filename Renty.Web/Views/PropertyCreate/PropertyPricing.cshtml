@model Renty.Web.Models.InputModels.Properties.PricingInputModel
@{
    ViewData["Title"] = "Цена";
}

<div class="property-pricing-page" data-currency="$">
    <h1 class="property-pricing-page__title">Теперь установите цены</h1>

    <form method="post">
        <label class="pricing-card" for="PricePerNight">
            <span class="pricing-card__label">Базовая цена</span>
            <span class="pricing-card__value">
                <span>$</span>
                <input type="number" asp-for="PricePerNight" class="pricing-card__input" />
            </span>
        </label>

        <label class="pricing-card" for="WeekendPricePercent">
            <span class="pricing-card__label">Коэффициент выходных</span>
            <span class="pricing-card__value">
                <span>+</span>
                <input type="number" asp-for="WeekendPricePercent" class="pricing-card__input pricing-card__input--percent" />
                <span>%</span>
            </span>
            <span class="pricing-card__hint" id="weekendPriceHint"></span>
        </label>

        <partial name="_StepFooter" />
    </form>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/pricing.js" asp-append-version="true"></script>
}
