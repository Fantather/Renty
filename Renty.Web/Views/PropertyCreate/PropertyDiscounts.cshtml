@model Renty.Web.Models.InputModels.Properties.DiscountsInputModel
@{
    ViewData["Title"] = "Скидки";
}

<div class="property-discounts-page">
    <h1 class="property-discounts-page__title">Добавьте скидки</h1>
    <p class="property-discounts-page__subtitle">Привлеките внимание гостей, чтобы быстрее получить первые бронирования и отзывы.</p>

    <form method="post">
        <div class="discount-card-list">
            <div class="discount-card">
                <div class="discount-card__percent">
                    <input type="number" asp-for="NewListingDiscountPercent" class="discount-card__percent-input" />
                    <span>%</span>
                </div>
                <div class="discount-card__info">
                    <span class="discount-card__title">Акция «Новое объявление»</span>
                    <p class="discount-card__description">Предложите скидку на первые 3 бронирования</p>
                </div>
                <label class="discount-toggle">
                    <input type="checkbox" asp-for="NewListingDiscountEnabled" class="discount-toggle__input" />
                    <span class="discount-toggle__track"><span class="discount-toggle__knob"></span></span>
                </label>
            </div>

            <div class="discount-card">
                <div class="discount-card__percent">
                    <input type="number" asp-for="LastMinuteDiscountPercent" class="discount-card__percent-input" />
                    <span>%</span>
                </div>
                <div class="discount-card__info">
                    <span class="discount-card__title">Скидка последней минуты</span>
                    <p class="discount-card__description">Для бронирований, оформленных менее чем за 14 дней до прибытия</p>
                </div>
                <label class="discount-toggle">
                    <input type="checkbox" asp-for="LastMinuteDiscountEnabled" class="discount-toggle__input" />
                    <span class="discount-toggle__track"><span class="discount-toggle__knob"></span></span>
                </label>
            </div>

            <div class="discount-card">
                <div class="discount-card__percent">
                    <input type="number" asp-for="WeeklyDiscountPercent" class="discount-card__percent-input" />
                    <span>%</span>
                </div>
                <div class="discount-card__info">
                    <span class="discount-card__title">Недельная скидка</span>
                    <p class="discount-card__description">Для поездок длительностью от 7 ночей</p>
                </div>
                <label class="discount-toggle">
                    <input type="checkbox" asp-for="WeeklyDiscountEnabled" class="discount-toggle__input" />
                    <span class="discount-toggle__track"><span class="discount-toggle__knob"></span></span>
                </label>
            </div>

            <div class="discount-card discount-card--has-error">
                <div class="discount-card__row">
                    <div class="discount-card__percent">
                        <input type="number" asp-for="MonthlyDiscountPercent" class="discount-card__percent-input" />
                        <span>%</span>
                    </div>
                    <div class="discount-card__info">
                        <span class="discount-card__title">Месячная скидка</span>
                        <p class="discount-card__description">Для поездок длительностью от 28 ночей</p>
                    </div>
                    <label class="discount-toggle">
                        <input type="checkbox" asp-for="MonthlyDiscountEnabled" class="discount-toggle__input" />
                        <span class="discount-toggle__track"><span class="discount-toggle__knob"></span></span>
                    </label>
                </div>
                <p class="discount-card__error" id="monthlyDiscountError" hidden></p>
            </div>
        </div>

        <button type="submit" class="property-discounts-next">Далее</button>
    </form>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/discounts.js" asp-append-version="true"></script>
}
