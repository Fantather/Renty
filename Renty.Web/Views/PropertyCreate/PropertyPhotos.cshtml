@model Renty.Web.Models.InputModels.Media.UploadPropertyImagesInputModel
@{
    ViewData["Title"] = "Фото";
}

<div class="property-photos-page">
    <h1 class="property-photos-page__title">Загрузите фото жилья</h1>
    <p class="property-photos-page__subtitle">Нужно минимум 5 фотографий.</p>

    <form method="post" enctype="multipart/form-data" asp-action="SavePropertyPhotos" asp-route-id="@Model.PropertyId">
        <input type="hidden" asp-for="PropertyId" />
        <input type="file" asp-for="Images" multiple accept="image/*" hidden />
        <input type="file" id="photoPicker" multiple accept="image/*" hidden />

        <div class="photo-grid" id="photoGrid"></div>

        <button type="submit" class="btn-primary property-photos-next" disabled>Далее</button>
    </form>
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/photos.js" asp-append-version="true"></script>
}
