@model Renty.Web.Models.InputModels.Media.UploadPropertyImagesInputModel
@{
    ViewData["Title"] = "Фото";
    ViewData["FormId"] = "photos-form";
}

<div class="property-photos-page">
    <h1 class="property-photos-page__title">Загрузите фото жилья</h1>
    <div asp-validation-summary="All"></div>

    <p class="property-photos-page__subtitle">Нужно минимум 5 фотографий.</p>

    <partial name="_PhotosForm" model="Model" />

    <partial name="_StepFooter" />
</div>

@section Scripts {
    <script type="module" src="~/js/property-create/photos.js" asp-append-version="true"></script>
}
