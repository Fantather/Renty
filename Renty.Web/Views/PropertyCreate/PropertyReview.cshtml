@model PropertyCardViewModel
@{
    ViewData["Title"] = "Публикация";
}

<div class="property-review-page">
    <h1 class="property-review-page__title">Поздравляем! Пора опубликовать объявление</h1>
    <p class="property-review-page__subtitle">Вот что увидят гости. Проверьте детали объявления перед публикацией.</p>
    <div asp-validation-summary="All"></div>

    <div class="property-review-preview" inert>
        <partial name="_PropertyCard" model="Model" />
    </div>

    <form method="post" id="property-form">
        <partial name="_StepFooter" />
    </form>
</div>
