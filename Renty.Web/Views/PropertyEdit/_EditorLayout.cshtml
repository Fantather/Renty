@{
    Layout = "_Layout";
    ViewData["Title"] = "Редактор объявления";
}

<div class="editor">
    <aside class="editor__sidebar">
        <a class="editor__back" href="@Url.Action("Index", "PropertyDrafts")">
            <icon name="chevron" class="editor__back-icon" />
        </a>
        <h1 class="editor__title">Редактор объявления</h1>
        <nav class="editor__menu">
            <vc:editor-menu />
        </nav>
    </aside>
    <script>
        try {
            var editorSidebarScroll = sessionStorage.getItem('editorSidebarScroll');
            if (editorSidebarScroll !== null) document.querySelector('.editor__sidebar').scrollTop = Number(editorSidebarScroll);
        } catch (e) { }
    </script>

    <section class="editor__content">
        <div asp-validation-summary="All"></div>
        @RenderBody()
    </section>

    @if (ViewData["FormId"] is string)
    {
        <partial name="_EditorFooter" />
    }
</div>

@section Scripts {
    <script type="module" src="~/js/property-edit/editor-menu.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
