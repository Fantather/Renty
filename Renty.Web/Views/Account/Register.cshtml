@model Renty.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
    var months = new[] { "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь" };
    var currentYear = DateTime.Today.Year;
}

<div class="register-page">
    <div class="register-card auth-card">
        <h1 class="auth-card__title">Регистрация</h1>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-card__form">
            <div asp-validation-summary="ModelOnly" class="auth-card__error"></div>
            <label class="auth-card__label" asp-for="FirstName">Имя</label>
            <input asp-for="FirstName" class="auth-card__input" />
            <span asp-validation-for="FirstName" class="auth-card__error"></span>

            <label class="auth-card__label" asp-for="LastName">Фамилия</label>
            <input asp-for="LastName" class="auth-card__input" />
            <span asp-validation-for="LastName" class="auth-card__error"></span>

            <label class="auth-card__label" asp-for="BirthDay">Дата рождения</label>
            <div class="birth-date">
                <select asp-for="BirthDay" class="auth-card__input">
                    <option value="">День</option>
                    @for (var day = 1; day <= 31; day++)
                    {
                        <option value="@day">@day</option>
                    }
                </select>
                <select asp-for="BirthMonth" class="auth-card__input">
                    <option value="">Месяц</option>
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@months[month - 1]</option>
                    }
                </select>
                <select asp-for="BirthYear" class="auth-card__input">
                    <option value="">Год</option>
                    @for (var year = currentYear; year >= currentYear - 100; year--)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="birth-date__errors">
                <span asp-validation-for="BirthDay" class="auth-card__error"></span>
                <span asp-validation-for="BirthMonth" class="auth-card__error"></span>
                <span asp-validation-for="BirthYear" class="auth-card__error"></span>
            </div>

            <label class="auth-card__label" asp-for="Email">Email</label>
            <input asp-for="Email" class="auth-card__input" />
            <span asp-validation-for="Email" class="auth-card__error"></span>

            <label class="auth-card__label" asp-for="Password">Пароль</label>
            <div class="password-field">
                <input asp-for="Password" class="auth-card__input" style="width: 100%; padding-right: 40px; box-sizing: border-box;" />
                <button type="button" class="password-toggle" data-target="Password">
                    <span class="eye-show"><icon name="eye" /></span>
                    <span class="eye-hide" hidden><icon name="eye-off" /></span>
                </button>
            </div>
            <span asp-validation-for="Password" class="auth-card__error"></span>

            <label class="auth-card__label" asp-for="ConfirmPassword">Подтверждение пароля</label>
            <div class="password-field">
                <input asp-for="ConfirmPassword" class="auth-card__input" style="width: 100%; padding-right: 40px; box-sizing: border-box;" />
                <button type="button" class="password-toggle" data-target="ConfirmPassword">
                    <span class="eye-show"><icon name="eye" /></span>
                    <span class="eye-hide" hidden><icon name="eye-off" /></span>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="auth-card__error"></span>

            <button type="submit" class="auth-card__submit">Зарегистрироваться</button>
        </form>

        <div class="auth-card__divider"><span>или</span></div>

        <a class="auth-card__google-btn" asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google">
            <icon name="google" class="auth-card__google-icon" />
            Продолжить с Google
        </a>

        <p class="auth-card__footer">Уже есть аккаунт? <a asp-controller="Home" asp-action="Index">Войти</a></p>
    </div>
</div>

@section Scripts {
    <script src="~/js/register/register.js" asp-append-version="true"></script>
    <script type="module" src="~/js/register/birth-date.js" asp-append-version="true"></script>
}
